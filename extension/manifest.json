{
  "manifest_version": 3,
  "name": "Web Table Exporter",
  "description": "选择网页表格，一键导出 xlsx/csv/json/md/html。支持虚拟滚动全量采集，兼容 Element Plus / AG Grid 等组件表格。支持列设置：拆分/筛选/格式化导出列，规则按页面自动记忆。",
  "version": "2.3.0",
  "action": {
    "default_title": "导出表格"
  },
  "permissions": ["activeTab", "scripting", "downloads", "storage"],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
