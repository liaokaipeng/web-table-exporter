{
  "manifest_version": 3,
  "name": "HTML2XLSX 表格导出",
  "description": "悬浮选择页面表格，一键导出为 xlsx / csv / json / md / html（支持合并单元格、多表格多 Sheet）",
  "version": "2.0.1",
  "action": {
    "default_title": "导出表格"
  },
  "permissions": ["activeTab", "scripting", "downloads", "storage"],
  "background": {
    "service_worker": "background/service-worker.js"
  },
  "icons": {
    "128": "icons/icon128.png"
  }
}
